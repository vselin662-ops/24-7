# Selin AI — Environment Variables
# Скопируй в .env и заполни значения

# Обязательные
GEMINI_API_KEY=your_gemini_api_key_here
MAX_BOT_TOKEN=your_max_bot_token_here
GROQ_API_KEY=your_groq_api_key_here
JWT_SECRET=your_secure_random_string_min_32_chars

# Опциональные
OPENROUTER_API_KEY=your_openrouter_api_key_here
PORT=3000
NODE_ENV=production
APP_URL=https://your-domain.com
EDGE_TTS_VOICE=ru-RU-DmitryNeural
REDIS_URL=redis://localhost:6379

# Платежные системы (ЮKassa и СБП)
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET=
YOOKASSA_SECRET_KEY=
SBP_PHONE=+7 (999) 000-00-00
OWNER_CHAT_ID=

# Безопасность и CORS
ALLOWED_ORIGINS=http://localhost:3000

# Firebase (опционально, для синхронизации)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
